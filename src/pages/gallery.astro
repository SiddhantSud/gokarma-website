---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSection from '../components/PhotoSection.astro';
import PageBanner from '../components/PageBanner.astro';
import Gallery from '../components/Gallery.astro';
---

<BaseLayout
  title="Gallery | Aangan by Gokarma Living"
  description="Photos of Aangan by Gokarma Living — the dorms, the Vintage Room, the forest paths, and the hand-painted sign that started it all."
  path="gallery.html"
  page="gallery"
  ogImage="community/game-night"
>
  <PageBanner
    eyebrow="A Closer Look"
    title="Gallery"
    subtitle="Click any photo to view it larger."
  />

  <PhotoSection bg="scenery/cottage-row" panel="alt">
    <div class="container">
      <Gallery />
    </div>
  </PhotoSection>
</BaseLayout>
