---
// ============================================================
// book.html no longer has its own page (Siddhant, 2026-11-23):
// every Book Now button goes straight to the StayFlexi booking
// engine. This stub only sends old links (Instagram bio, saved
// bookmarks) on to StayFlexi instead of showing a 404.
// ============================================================
import { BOOKING } from '../config/booking';

const target = BOOKING.stayflexiBookingUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Book your stay | Aangan by Gokarma Living</title>
  </head>
  <body>
    <p>
      Taking you to our booking page… <a href={target}>Continue</a>
    </p>
  </body>
</html>
