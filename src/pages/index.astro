---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Marquee from '../components/Marquee.astro';
import BookingWidget from '../components/BookingWidget.astro';
import RoomCard from '../components/RoomCard.astro';
import GuideCard from '../components/GuideCard.astro';
import VibeStrip from '../components/VibeStrip.astro';
import Nearby from '../components/Nearby.astro';
import Amenities from '../components/Amenities.astro';
import Reviews from '../components/Reviews.astro';
import GettingHere from '../components/GettingHere.astro';
import { SITE } from '../config/site';
import { ROOMS } from '../data/rooms';
import { GUIDE_POSTS } from '../data/guide';
import { photoUrl } from '../lib/images';

const heroBg = await photoUrl('property/property-4');
const ratingLine = `${SITE.rating}★ on Google · ${SITE.reviewCount} Reviews`;

// Business details Google reads (schema.org LodgingBusiness).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: SITE.name,
  image: new URL(heroBg, Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.latitude,
    longitude: SITE.geo.longitude,
  },
  hasMap: SITE.mapUrl,
  telephone: '+91-78928-03231',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: SITE.rating,
    bestRating: '5',
    ratingCount: String(SITE.reviewCount),
  },
};
---

<BaseLayout
  title="Aangan by Gokarma Living | Backpacker Hostel & Cafe in Gokarna"
  description="A backpacker hostel & cafe on Kudle hilltop, Gokarna — dorms and private rooms, home-style South Indian food, and the offbeat basecamp for backpacking, solo travel, and exploring Gokarna beyond the beaches."
  path="index.html"
  page="home"
  jsonLd={jsonLd}
>
  <!-- ============ HERO ============ -->
  <section id="home" class="hero" style={`background-image: url('${heroBg}');`}>
    <div class="hero-overlay">
      <span class="section-eyebrow">Kudle Hilltop, Gokarna</span>
      <h1>Your Nest on Kudle Hilltop</h1>
      <p>
        A backpacker hostel &amp; cafe tucked into the forest above Kudle Beach — the offbeat
        basecamp for exploring Gokarna.
      </p>
      <div class="hero-actions">
        <a href="#check-availability" class="btn btn-primary btn-large">
          Check Availability
        </a>
        <a href="rooms.html" class="explore-link">
          See the rooms first →
        </a>
      </div>
    </div>
  </section>

  <!-- ============ TRUST MARQUEE ============ -->
  <Marquee
    items={[ratingLine, 'Kudle Hilltop, Gokarna', 'Home-Cooked Food', 'Loved by Solo Travellers']}
  />

  <!-- ============ THE VIBE + PHOTO STRIP ============ -->
  <PhotoSection bg="scenery/cottage-row">
    <div class="container">
      <span class="section-eyebrow">The Vibe</span>
      <h2 class="section-title">Slow Days on Kudle Hilltop</h2>
      <p class="section-subtitle">
        Aangan is a hostel and cafe for living slowly and mostly outdoors: mornings under the trees,
        a big garden to spread out in, sunset walks along the cliffs, and board games that run late.
        There's Wi-Fi when you need it, a top-rated cafe when you're hungry, hand-painted walls
        everywhere, and cats, dogs and birds for company.
      </p>
      <VibeStrip />
      <p class="text-center mt-lg">
        <a href="story.html" class="explore-link">
          Meet Kushal &amp; Geetika, our hosts →
        </a>
      </p>
    </div>
  </PhotoSection>

  <!-- ============ CHECK AVAILABILITY ============ -->
  <PhotoSection bg="scenery/verandah" panel="alt" panelClass="text-center">
    <div class="container" id="check-availability">
      <span class="section-eyebrow">Book Direct</span>
      <h2 class="section-title">Check Availability</h2>
      <p class="section-subtitle">
        Dorm beds start from around ₹{SITE.dormPriceFrom}/night. Pick your dates to see live rates.
      </p>
      <BookingWidget class="booking-inline" />
    </div>
  </PhotoSection>

  <!-- ============ WALKABLE FROM AANGAN ============ -->
  <PhotoSection bg="community/chess-night">
    <div class="container">
      <span class="section-eyebrow">Right on the Doorstep</span>
      <h2 class="section-title">Everything's a Walk Away</h2>
      <p class="section-subtitle">
        Kudle Beach on one side, the temple town and Main Beach on the other, and the hilltop
        sunsets up the path. No autos needed.
      </p>
      <Nearby />
    </div>
  </PhotoSection>

  <!-- ============ AMENITIES ============ -->
  <PhotoSection bg="community/catan-night" panel="alt">
    <div class="container">
      <span class="section-eyebrow">What's Included</span>
      <h2 class="section-title">Amenities</h2>
      <p class="section-subtitle">Everything you need for an easy stay.</p>
      <Amenities />
    </div>
  </PhotoSection>

  <!-- ============ STORIES WE HAVE LIVED (guest reviews) ============ -->
  <PhotoSection bg="community/game-night">
    <div class="container">
      <span class="section-eyebrow">{ratingLine}</span>
      <h2 class="section-title">Stories We Have Lived</h2>
      <Reviews />
    </div>
  </PhotoSection>

  <!-- ============ HOW TO REACH US ============ -->
  <PhotoSection bg="property/dorm-outside-2" panel="alt">
    <div class="container" id="getting-here">
      <span class="section-eyebrow">Getting Here</span>
      <h2 class="section-title">How to Reach Us</h2>
      <p class="section-subtitle">
        From Bangalore, Mumbai or the airport, then a short auto ride up the hill.
      </p>
      <GettingHere />
    </div>
  </PhotoSection>

  <!-- ============ ROOMS TEASER ============ -->
  <PhotoSection bg="property/dorm-outside-1">
    <div class="container">
      <span class="section-eyebrow">Where You'll Sleep</span>
      <h2 class="section-title">Rooms</h2>
      <p class="section-subtitle">
        Dorm beds start from around ₹{SITE.dormPriceFrom}/night — pick your dates to check exact
        rates.
      </p>
      <div class="auto-grid grid-min-280">
        {ROOMS.slice(0, 3).map((room) => (
          <RoomCard room={room} />
        ))}
      </div>
      <p class="text-center mt-lg">
        <a href="rooms.html" class="explore-link">
          See all rooms &amp; full details →
        </a>
      </p>
    </div>
  </PhotoSection>

  <!-- ============ GOKARNA GUIDE TEASER ============ -->
  <PhotoSection bg="scenery/waterfall" panel="alt">
    <div class="container">
      <span class="section-eyebrow">The Gokarna Guide</span>
      <h2 class="section-title">Plan Your Trip</h2>
      <p class="section-subtitle">
        Real, practical guides for backpacking, solo travel, and finding Gokarna's offbeat side.
      </p>
      <div class="auto-grid grid-min-260">
        {GUIDE_POSTS.map((post) => (
          <GuideCard post={post} />
        ))}
      </div>
    </div>
  </PhotoSection>

  <!-- ============ LOCATION TEASER + FINAL CTA ============ -->
  <PhotoSection bg="scenery/river-pool" panelClass="text-center">
    <div class="container">
      <span class="section-eyebrow">Kudle Beach Road, Gokarna</span>
      <h2 class="section-title">Ready to Stay?</h2>
      <p class="section-subtitle">Pick your dates and we'll take it from there.</p>
      <div class="hero-actions">
        <a href="book.html" class="btn btn-primary btn-large">
          Book Your Stay
        </a>
        <a href="gallery.html" class="explore-link">
          See the gallery →
        </a>
      </div>
    </div>
  </PhotoSection>
</BaseLayout>
