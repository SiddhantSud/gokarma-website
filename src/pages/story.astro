---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Photo from '../components/Photo.astro';

// The full-colour Aangan seal from the logo kit (public/brand/), shown
// as a badge above the heading. The kit asks for at least 96px.
const seal = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}brand/aangan-seal-full-colour.svg`;
---

<BaseLayout
  title="Our Story | Aangan by Gokarma Living"
  description="Meet Kushal and Geetika, the hosts behind Aangan by Gokarma Living — the hostel, the cafe, and the resident cats that make it feel like home."
  path="story.html"
  page="story"
  ogImage="kushal-geetika"
>
  <PhotoSection bg="property/property-4">
    <div class="container story-grid">
      <Photo
        src="kushal-geetika"
        alt="Kushal and Geetika, owners of the hostel and cafe, smiling together"
        class="story-photo reveal"
        sizes="(max-width: 800px) 100vw, 420px"
        loading="eager"
      />

      <div class="story-text reveal">
        <img
          class="story-seal"
          src={seal}
          alt="Aangan by GoKarma Living seal"
          width="112"
          height="112"
        />
        <span class="section-eyebrow">Our Story</span>
        <h1>Meet Kushal &amp; Geetika</h1>
        <p class="story-intro">
          Aangan by Gokarma Living started as a small dream between two people who love good food,
          good company, and meeting travelers from every corner of the world. Today, Kushal and
          Geetika run both the hostel and the cozy cafe on-site — home to resident cats, the odd
          curious goat at the gate, and a menu guests keep coming back for (the Karam Podi Dosa has
          quite the following).
        </p>

        <div class="owner-bio">
          <h3>Kushal</h3>
          <p>
            The friendly face you'll usually find behind the counter or swapping travel stories with
            guests. Kushal handles the day-to-day running of the hostel and cafe, and guests often
            mention how quickly he makes a new arrival feel at home — several reviews single him out
            by name for going out of his way to help plan the day's beach trek or track down a
            missed bus.
          </p>
        </div>

        <div class="owner-bio">
          <h3>Geetika</h3>
          <p>
            The warmth behind the common spaces and the care behind the cafe's menu. Guests fondly
            call her "Geet" — and more than a few have said they wish they'd booked a longer stay
            once they got to know her.
          </p>
        </div>
      </div>
    </div>
  </PhotoSection>

  <PhotoSection bg="community/chess-night" panel="alt">
    <div class="container">
      <span class="section-eyebrow">In Their Own Words (Almost)</span>
      <h2 class="section-title">What Guests Notice</h2>
      <p class="section-subtitle">A few things travelers keep mentioning in reviews.</p>
      <div class="auto-grid grid-min-240">
        <div class="card reveal">
          <p>
            &ldquo;This place captures the core vibe of Gokarna — being present in nature, meeting
            new people, and falling back in love with being alive.&rdquo;
          </p>
        </div>
        <div class="card reveal">
          <p>
            &ldquo;Great food, lovely animals, including a monkey playing in the morning and a frog
            in the bathroom — perfect vibe and music.&rdquo;
          </p>
        </div>
        <div class="card reveal">
          <p>&ldquo;Food is top notch, and host Kushal is really cheerful and helpful.&rdquo;</p>
        </div>
      </div>
    </div>
  </PhotoSection>

  <PhotoSection bg="food/dal-rice" panelClass="text-center">
    <div class="container">
      <h2 class="section-title">See Where You'd Stay</h2>
      <p class="section-subtitle">Dorms, a private room, and the cafe that ties it all together.</p>
      <a href="rooms.html" class="explore-link">
        Browse rooms &amp; rates →
      </a>
    </div>
  </PhotoSection>
</BaseLayout>
