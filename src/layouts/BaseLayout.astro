---
// ============================================================
// The shell every page is built from: <head> (title, SEO and
// social-preview tags, fonts, styles), the header, the footer
// and the shared page script. A page only supplies its own
// content:
//
//   <BaseLayout title="..." description="..." path="rooms.html" page="rooms">
//     ...sections...
//   </BaseLayout>
//
// variant="landing" is for landing.html (the ad landing page):
// a centered logo instead of the nav, a short footer, and
// hidden from search engines.
// ============================================================
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { photoUrl } from '../lib/images';

// Fonts are served from this site (not Google), so visitors'
// browsers don't contact a third party just to show text.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

import '../styles/theme.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  title: string;
  description: string;
  /** This page's file name, e.g. "rooms.html" -- used for the canonical URL. */
  path: string;
  /** Which nav link to highlight: home, rooms, story, guide, gallery, contact. */
  page?: string;
  /** Photo for link previews on WhatsApp, Instagram, etc. */
  ogImage?: string;
  /** Structured data for Google (schema.org), written out as JSON-LD. */
  jsonLd?: Record<string, unknown>;
  variant?: 'site' | 'landing';
}

const {
  title,
  description,
  path,
  page,
  ogImage = 'property/property-4',
  jsonLd,
  variant = 'site',
} = Astro.props;

const isLanding = variant === 'landing';
const siteRoot = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site);
const pageUrl = new URL(path, siteRoot).href;
const ogImageUrl = new URL(await photoUrl(ogImage), Astro.site).href;
// Files in public/ (favicons, the logo kit in public/brand/) are served
// under the site's base path, so their URLs start with it.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#3c0008" />
    {isLanding ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={pageUrl} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-page={page}>
    {isLanding ? (
      <header class="site-header">
        <div class="container header-inner is-centered">
          <a href="index.html" class="logo">
            <span class="logo-mark" aria-hidden="true">
              <img
                class="logo-mark-light"
                src={`${base}brand/aangan-mark-reversed-for-dark-backgrounds.svg`}
                alt=""
                width="46"
                height="49"
              />
              <img
                class="logo-mark-colour"
                src={`${base}brand/aangan-mark-full-colour.svg`}
                alt=""
                width="46"
                height="49"
              />
            </span>
            <span class="logo-text">
              <span>{SITE.shortName}</span>
              <span class="logo-by">by {SITE.brand}</span>
            </span>
          </a>
        </div>
      </header>
    ) : (
      <Header page={page} />
    )}

    <slot />

    {isLanding ? (
      <footer class="site-footer">
        <div class="container footer-inner is-centered">
          <p>
            &copy; <span id="year">{new Date().getFullYear()}</span> {SITE.name}.
          </p>
        </div>
      </footer>
    ) : (
      <Footer />
    )}

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
