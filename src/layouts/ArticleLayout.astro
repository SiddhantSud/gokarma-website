---
// ============================================================
// Layout for a Gokarna Guide article: hero photo, title, the
// article text, a photo slideshow, an optional "stay with us"
// box, then "Related reads". The tag, the line under the title
// and the list of sources are kept in the article files but not
// shown on the page (Siddhant, 2026-11-15). Adds the Article structured data Google
// reads. Everything comes from the article's Markdown file in
// src/content/guide/ (see src/content.config.ts for the fields).
// ============================================================
import BaseLayout from './BaseLayout.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Photo from '../components/Photo.astro';
import RelatedReads from '../components/RelatedReads.astro';
import { SITE } from '../config/site';
import { BOOKING } from '../config/booking';
import { articleHref, type GuideArticle } from '../lib/guide';

interface Props {
  article: GuideArticle;
}

const { article } = Astro.props;
const { data } = article;
const path = articleHref(article);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  author: data.author
    ? { '@type': 'Person', name: data.author }
    : { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  datePublished: data.date.toISOString().slice(0, 10),
};
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | ${SITE.name}`}
  description={data.description}
  path={path}
  page="guide"
  ogImage={data.image}
  jsonLd={jsonLd}
>
  <PhotoSection bg={data.backdrop ?? 'scenery/river-pool'}>
    <div class="container">
      <div class="article-hero photo-box tall">
        <Photo
          src={data.image}
          alt={data.imageAlt}
          sizes="(max-width:800px) 100vw, 720px"
          loading="eager"
        />
      </div>
      {data.imageCredit && (
        <p class="photo-credit">
          Photo:{' '}
          {data.imageCreditUrl ? (
            <a href={data.imageCreditUrl} target="_blank" rel="noopener">
              {data.imageCredit}
            </a>
          ) : (
            data.imageCredit
          )}
        </p>
      )}

      <div class="article-body">
        <h1>{data.title}</h1>
        {data.author && <p class="article-meta">By {data.author}</p>}

        <slot />

        {data.gallery.length > 0 && (
          <div class="article-gallery" data-slideshow>
            {data.gallery.map((item, i) => (
              <figure class:list={{ 'is-active': i === 0 }}>
                <div class="photo-box">
                  <Photo src={item.image} alt={item.alt} sizes="(max-width:800px) 100vw, 360px" />
                </div>
                {item.credit && (
                  <figcaption class="photo-credit">
                    Photo:{' '}
                    {item.creditUrl ? (
                      <a href={item.creditUrl} target="_blank" rel="noopener">
                        {item.credit}
                      </a>
                    ) : (
                      item.credit
                    )}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        )}

        {data.ctaTitle && (
          <div class="cta-banner">
            <h3>{data.ctaTitle}</h3>
            {data.ctaText && <p>{data.ctaText}</p>}
            <a href={BOOKING.stayflexiBookingUrl} class="btn btn-primary">
              Book Your Stay
            </a>
          </div>
        )}
      </div>
    </div>
  </PhotoSection>

  <PhotoSection bg={data.relatedBackdrop ?? 'community/catan-night'} panel="alt">
    <div class="container">
      <RelatedReads current={article.id} />
    </div>
  </PhotoSection>
</BaseLayout>

<script>
  // The article's extra photos change on their own every few
  // seconds. Visitors who have asked their device to reduce
  // motion see all the photos side by side instead (guide.css).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((show) => {
    const slides = Array.from(show.querySelectorAll('figure'));
    if (reduceMotion || slides.length < 2) return;

    const SHOW_FOR_MS = 4500;
    let index = 0;
    show.classList.add('is-rotating');
    window.setInterval(() => {
      slides[index].classList.remove('is-active');
      index = (index + 1) % slides.length;
      slides[index].classList.add('is-active');
    }, SHOW_FOR_MS);
  });
</script>
