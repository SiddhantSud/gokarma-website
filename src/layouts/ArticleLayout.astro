---
// ============================================================
// Layout for a Gokarna Guide article: hero photo, title block,
// the article text, an optional "stay with us" box, then
// "Related reads". Adds the Article structured data Google
// reads. Everything comes from the article's Markdown file in
// src/content/guide/ (see src/content.config.ts for the fields).
// ============================================================
import BaseLayout from './BaseLayout.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Photo from '../components/Photo.astro';
import RelatedReads from '../components/RelatedReads.astro';
import { SITE } from '../config/site';
import { articleHref, type GuideArticle } from '../lib/guide';

interface Props {
  article: GuideArticle;
}

const { article } = Astro.props;
const { data } = article;
const path = articleHref(article);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  author: data.author
    ? { '@type': 'Person', name: data.author }
    : { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  datePublished: data.date.toISOString().slice(0, 10),
};
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | ${SITE.name}`}
  description={data.description}
  path={path}
  page="guide"
  ogImage={data.image}
  jsonLd={jsonLd}
>
  <PhotoSection bg={data.backdrop ?? 'scenery/river-pool'}>
    <div class="container">
      <div class="article-hero photo-box tall">
        <Photo
          src={data.image}
          alt={data.imageAlt}
          sizes="(max-width:800px) 100vw, 720px"
          loading="eager"
        />
      </div>

      <div class="article-body">
        <span class="section-eyebrow">{data.tag}</span>
        <h1>{data.title}</h1>
        {data.subtitle && <p class="article-meta">{data.subtitle}</p>}
        {data.author && <p class="article-meta">By {data.author}</p>}

        <slot />

        {data.ctaTitle && (
          <div class="cta-banner">
            <h3>{data.ctaTitle}</h3>
            {data.ctaText && <p>{data.ctaText}</p>}
            <a href="rooms.html" class="btn btn-primary">
              See Rooms &amp; Rates
            </a>
          </div>
        )}
      </div>
    </div>
  </PhotoSection>

  <PhotoSection bg={data.relatedBackdrop ?? 'community/catan-night'} panel="alt">
    <div class="container">
      <RelatedReads current={article.id} />
    </div>
  </PhotoSection>
</BaseLayout>
