---
// "Related reads" links under a guide article: every other
// published article in src/content/guide/.
import { articleHref, getGuideArticles } from '../lib/guide';

interface Props {
  /** The current article's id (file name without .md), left out of the list. */
  current: string;
}

const { current } = Astro.props;
const others = (await getGuideArticles()).filter((article) => article.id !== current);
---

<div class="related-reads">
  <h2 class="section-title">Related Reads</h2>
  <ul>
    {others.map((article) => (
      <li>
        <a class="explore-link" href={articleHref(article)}>
          {article.data.title} →
        </a>
      </li>
    ))}
  </ul>
</div>
