---
// ============================================================
// One responsive photo. Give it a path inside src/assets/images
// (no extension) and Astro builds WebP + JPEG copies at 480,
// 900 and 1600px wide, and the browser picks the right size.
// Widths larger than the original photo are skipped.
// Built copies never contain the camera's location (GPS) data.
//
//   <Photo src="rooms/4-bed-dorm-1" alt="..." sizes="..." />
// ============================================================
import { Picture } from 'astro:assets';
import { photo } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  sizes = '(max-width: 700px) 100vw, 400px',
  class: className = 'photo-cover',
  loading = 'lazy',
} = Astro.props;

const image = await photo(src);
// The plain <img src> (for very old browsers) points at the
// largest copy rather than the multi-megabyte original.
const fallbackWidth = Math.min(1600, image.width);
---

<Picture
  src={image}
  width={fallbackWidth}
  alt={alt}
  widths={[480, 900, 1600]}
  sizes={sizes}
  formats={['webp']}
  fallbackFormat="jpg"
  class={className}
  loading={loading}
  decoding="async"
/>
