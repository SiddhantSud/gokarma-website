---
// One Gokarna Guide article card. Articles come from the
// Markdown files in src/content/guide/.
import Photo from './Photo.astro';
import { articleHref, type GuideArticle } from '../lib/guide';

interface Props {
  article: GuideArticle;
}

const { article } = Astro.props;
const { data } = article;
---

<a href={articleHref(article)} class="card guide-card reveal">
  <div class="photo-box small">
    <Photo src={data.image} alt={data.imageAlt} sizes="(max-width: 700px) 100vw, 340px" />
  </div>
  <span class="tag">{data.tag}</span>
  <h3>{data.title}</h3>
  <p>{data.excerpt}</p>
</a>
