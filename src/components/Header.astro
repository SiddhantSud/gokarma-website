---
// ============================================================
// The site-wide header and navigation. `page` marks which nav
// link gets the "current page" highlight.
// The glass-on-scroll effect and the mobile menu button are
// wired up in src/scripts/site.ts.
// ============================================================
import { AANGAN_WORDS } from '../config/site';

interface Props {
  page?: string;
}

const { page } = Astro.props;

// The courtyard mark from the Aangan logo kit (public/brand/).
// Two copies: a cream one that reads over the hero photo, and the
// full-colour one shown once the header turns to glass on scroll
// (header.css swaps them).
const brand = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}brand/`;

// The "Aangan" name on the left is the link back to Home, so
// Home isn't repeated in the list.
const links = [
  { href: 'rooms.html', page: 'rooms', label: 'Stay' },
  { href: 'story.html', page: 'story', label: 'Our Story' },
  { href: 'guide.html', page: 'guide', label: 'Gokarna Guide' },
  { href: 'gallery.html', page: 'gallery', label: 'Gallery' },
  { href: 'contact.html', page: 'contact', label: 'Contact Us' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="index.html" class="logo" aria-label="Aangan, home page">
      <span class="logo-mark" aria-hidden="true">
        <img
          class="logo-mark-light"
          src={`${brand}aangan-mark-reversed-for-dark-backgrounds.svg`}
          alt=""
          width="38"
          height="40"
        />
        <img
          class="logo-mark-colour"
          src={`${brand}aangan-mark-full-colour.svg`}
          alt=""
          width="38"
          height="40"
        />
      </span>
      <span class="logo-word" data-words={JSON.stringify(AANGAN_WORDS)} aria-hidden="true">
        Aangan
      </span>
    </a>

    <button
      class="menu-toggle btn-circle"
      id="menuToggle"
      aria-label="Open menu"
      aria-expanded="false"
    >
      ☰
    </button>

    <nav class="main-nav" id="mainNav">
      {links.map((link) => (
        <a href={link.href} class:list={{ 'is-active': link.page === page }}>
          {link.label}
        </a>
      ))}
      <a href="book.html" class="nav-cta">
        Book Now
      </a>
    </nav>
  </div>
</header>
